# CozyBlocks Phase 2 — local demo environment (no real secrets)
# Copy to .env or export in your shell before launching.

# --- House multiplayer server ---
# Port the authoritative Godot WebSocket server listens on
COZY_NET_PORT=9080

# Directory for persistent house JSON (survives server restart)
# Default inside Godot: user://houses
# For a shared folder when running headless server:
COZY_HOUSE_DATA=/tmp/cozyblocks_houses

# --- Clients ---
# Server host clients connect to
COZY_NET_HOST=127.0.0.1

# Local demo identity (NOT production auth). Stable per player for local tests.
# Server hashes this into a player_id; do not treat as secure login.
COZY_DEV_IDENTITY=alice
COZY_DISPLAY_NAME=Alice

# Optional: auto-join a friend's invite instead of entering own house
# COZY_JOIN_INVITE=ABC123

# Set to 0 to skip auto-connect in the house scene
# COZY_NET_AUTOSTART=1

# --- Meadow / Phase 1 helpers ---
# COZY_FORCE_TOUCH=1
# COZY_SMOKE=1
# COZY_SMOKE_QUIT=1
# COZY_SCREENSHOTS=1
# COZY_SHOT_DIR=/opt/cursor/artifacts/screenshots/phase2
# COZY_PLACE_UI_TEST=1
